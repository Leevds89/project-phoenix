# Use mock, openai, openai-compatible, anthropic, gemini, or ollama
AI_PROVIDER=mock

# Required for openai, anthropic, and gemini.
# For openai-compatible, required only for remote providers; local servers may omit it.
# Ollama local does not use an API key.
AI_API_KEY=

# Optional for built-in connectors; defaults are supplied by Phoenix.
# Required for openai-compatible. Examples:
# OpenAI-compatible cloud: https://your-provider.example/v1
# Local LM Studio:         http://127.0.0.1:1234/v1
# Local vLLM:              http://127.0.0.1:8000/v1
# Ollama:                  http://127.0.0.1:11434
AI_API_URL=

# Required for every real connector. Use the exact model ID supported by your provider.
AI_MODEL=

# Optional Anthropic API version override.
# ANTHROPIC_VERSION=2023-06-01

# Local ports
PORT=3001
CLIENT_PORT=5173
